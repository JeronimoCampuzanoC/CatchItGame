// DiamondSprite.jack
// Draws a 32x32 diamond (rhombus) at the top of a given column (1..4).
class DiamondSprite {

    function void drawAtColumnTop(int column) {
        do DiamondSprite.drawAtColumnTopWithOffset(column, 0);
        return;
    }

    function void drawAtColumnTopWithOffset(int column, int yOffset) {
        var int colWidth, cx;
        let colWidth = 512 / 4;
        let cx = (column - 1) * colWidth + (colWidth / 2);
        do DiamondSprite.drawDiamond32At(cx, yOffset);
        return;
    }

    function void drawDiamond32At(int cx, int yTop) {
        var Array w; var int i, y, half, x0, x1;

        // Perfectly symmetric: grow to 32, then shrink.
        let w = Array.new(32);
        // top tip to mid
        let w[0]  = 2;   let w[1]  = 4;   let w[2]  = 6;   let w[3]  = 8;
        let w[4]  = 10;  let w[5]  = 12;  let w[6]  = 14;  let w[7]  = 16;
        let w[8]  = 18;  let w[9]  = 20;  let w[10] = 22;  let w[11] = 24;
        let w[12] = 26;  let w[13] = 28;  let w[14] = 30;  let w[15] = 32;
        // mid to bottom tip
        let w[16] = 32;  let w[17] = 30;  let w[18] = 28;  let w[19] = 26;
        let w[20] = 24;  let w[21] = 22;  let w[22] = 20;  let w[23] = 18;
        let w[24] = 16;  let w[25] = 14;  let w[26] = 12;  let w[27] = 10;
        let w[28] = 8;   let w[29] = 6;   let w[30] = 4;   let w[31] = 2;

        let i = 0;
        while (i < 32) {
            let half = w[i] / 2;
            let x0 = cx - half;
            let x1 = cx + half - 1;
            let y = yTop + i;
            do Screen.drawRectangle(x0, y, x1, y);
            let i = i + 1;
        }
        do w.dispose();
        return;
    }
}
