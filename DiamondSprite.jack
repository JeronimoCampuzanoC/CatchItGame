// DiamondSprite.jack
// Draws a 32x32 diamond (rhombus) at the top of a given column (1..4).
class DiamondSprite {
    field int y, prevY, column;
    field bool active;

    constructor DiamondSprite new(int col) {
        let column = col;
        let y = 0;
        let prevY = -1;
        let active = true;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method int getY() {
        return y;
    }

    method void setY(int newY) {
        let y = newY;
        return;
    }

    method void updatePosition(int speed) {
        let prevY = y;
        let y = y + speed;
        return;
    }

    method void draw() {
        do Screen.setColor(true);
        do DiamondSprite.drawAtColumnTopWithOffset(column, y);
        return;
    }

    method void erase() {
        if (prevY > (-1)) {
            do Screen.setColor(false);
            do DiamondSprite.drawAtColumnTopWithOffset(column, prevY);
        }
        return;
    }

    method void eraseCurrent() {
        do Screen.setColor(false);
        do DiamondSprite.drawAtColumnTopWithOffset(column, y);
        return;
    }

    method bool isActive() {
        return active;
    }

    method void setActive(bool val) {
        let active = val;
        return;
    }

    method int getDistanceFrom(int targetY) {
        var int dy;
        let dy = y - targetY;
        if (dy < 0) {
            let dy = 0 - dy;
        }
        return dy;
    }

    function void drawAtColumnTop(int column) {
        do DiamondSprite.drawAtColumnTopWithOffset(column, 0);
        return;
    }

    function void drawAtColumnTopWithOffset(int column, int yOffset) {
        var int colWidth, cx;
        let colWidth = 512 / 4;
        let cx = (column - 1) * colWidth + (colWidth / 2);
        do DiamondSprite.drawDiamond32At(cx, yOffset);
        return;
    }

    function void drawDiamond32At(int cx, int yTop) {
        var Array w; var int i, y, half, x0, x1;

        // Perfectly symmetric: grow to 32, then shrink.
        let w = Array.new(32);
        // top tip to mid
        let w[0]  = 2;   let w[1]  = 4;   let w[2]  = 6;   let w[3]  = 8;
        let w[4]  = 10;  let w[5]  = 12;  let w[6]  = 14;  let w[7]  = 16;
        let w[8]  = 18;  let w[9]  = 20;  let w[10] = 22;  let w[11] = 24;
        let w[12] = 26;  let w[13] = 28;  let w[14] = 30;  let w[15] = 32;
        // mid to bottom tip
        let w[16] = 32;  let w[17] = 30;  let w[18] = 28;  let w[19] = 26;
        let w[20] = 24;  let w[21] = 22;  let w[22] = 20;  let w[23] = 18;
        let w[24] = 16;  let w[25] = 14;  let w[26] = 12;  let w[27] = 10;
        let w[28] = 8;   let w[29] = 6;   let w[30] = 4;   let w[31] = 2;

        let i = 0;
        while (i < 32) {
            let y = yTop + i;
            // Only draw if within screen bounds
            if ((y > (-1)) & (y < 256)) {
                let half = w[i] / 2;
                let x0 = cx - half;
                let x1 = cx + half - 1;
                do Screen.drawRectangle(x0, y, x1, y);
            }
            let i = i + 1;
        }
        do w.dispose();
        return;
    }
}
