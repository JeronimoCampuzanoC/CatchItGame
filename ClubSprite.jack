// ClubSprite.jack
// Draws a 32x32 club at the top of a given column (1..4).
// Three lobes (top/left/right) + short stem and base.
class ClubSprite {
    field int y, prevY, column;
    field bool active;

    constructor ClubSprite new(int col) {
        let column = col;
        let y = 0;
        let prevY = -1;
        let active = false;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method int getY() {
        return y;
    }

    method void setY(int newY) {
        let y = newY;
        return;
    }

    method void updatePosition(int speed) {
        let prevY = y;
        let y = y + speed;
        return;
    }

    method void draw() {
        do Screen.setColor(true);
        do ClubSprite.drawAtColumnTopWithOffset(column, y);
        return;
    }

    method void erase() {
        if (prevY > (-1)) {
            do Screen.setColor(false);
            do ClubSprite.drawAtColumnTopWithOffset(column, prevY);
        }
        return;
    }

    method void eraseCurrent() {
        do Screen.setColor(false);
        do ClubSprite.drawAtColumnTopWithOffset(column, y);
        return;
    }

    method bool isActive() {
        return active;
    }

    method void setActive(bool val) {
        let active = val;
        return;
    }

    method int getDistanceFrom(int targetY) {
        var int dy;
        let dy = y - targetY;
        if (dy < 0) {
            let dy = 0 - dy;
        }
        return dy;
    }

    function void drawAtColumnTop(int column) {
        do ClubSprite.drawAtColumnTopWithOffset(column, 0);
        return;
    }

    function void drawAtColumnTopWithOffset(int column, int yOffset) {
        var int colWidth, cx;
        let colWidth = 512 / 4;
        let cx = (column - 1) * colWidth + (colWidth / 2);
        do ClubSprite.drawClub32At(cx, yOffset);
        return;
    }

    function void drawClub32At(int cx, int yTop) {
        var int i, y, half, x0, x1, halfGap, left0, left1, right0, right1;
        var Array w; var Array gl; var Array gc; var Array gr;

        // --- Top center lobe (rows 0..5) as single centered span ---
        let w = Array.new(6);
        let w[0] = 6;  let w[1] = 10; let w[2] = 14;
        let w[3] = 16; let w[4] = 14; let w[5] = 12;

        let i = 0;
        while (i < 6) {
            let y = yTop + i;
            // Only draw if within screen bounds
            if ((y > (-1)) & (y < 256)) {
                let half = w[i] / 2;
                let x0 = cx - half;
                let x1 = cx + half - 1;
                do Screen.drawRectangle(x0, y, x1, y);
            }
            let i = i + 1;
        }

        // --- Side lobes (rows 6..13): left and right spans with a small center gap ---
        // For each row: left/right span width and center gap.
        let gl = Array.new(8);  // side lobe width
        let gc = Array.new(8);  // center gap
        // wider lobes, small center gap to suggest three circles blending
        let gl[0] = 10; let gc[0] = 4;
        let gl[1] = 12; let gc[1] = 4;
        let gl[2] = 12; let gc[2] = 6;
        let gl[3] = 12; let gc[3] = 6;
        let gl[4] = 10; let gc[4] = 6;
        let gl[5] = 10; let gc[5] = 8;
        let gl[6] = 8;  let gc[6] = 8;
        let gl[7] = 8;  let gc[7] = 10;

        let i = 0;
        while (i < 8) {
            let y = yTop + 6 + i;
            // Only draw if within screen bounds
            if ((y > (-1)) & (y < 256)) {
                let halfGap = gc[i] / 2;
                // Left span
                let left1 = cx - halfGap - 1;
                let left0 = left1 - gl[i] + 1;
                // Right span
                let right0 = cx + halfGap;
                let right1 = right0 + gl[i] - 1;

                do Screen.drawRectangle(left0,  y, left1,  y);
                do Screen.drawRectangle(right0, y, right1, y);
            }

            let i = i + 1;
        }

        // --- Neck / stem and base (rows 14..31) ---
        // narrow neck, then stem, then a slightly wider base cap.
        let gr = Array.new(18);    // widths rows 14..31
        let gr[0]  = 10;  // row 14 (blend under lobes)
        let gr[1]  = 8;   // 15
        let gr[2]  = 8;   // 16
        let gr[3]  = 8;   // 17
        let gr[4]  = 6;   // 18 stem
        let gr[5]  = 6;   // 19 stem
        let gr[6]  = 6;   // 20 stem
        let gr[7]  = 6;   // 21 stem
        let gr[8]  = 6;   // 22 stem
        let gr[9]  = 6;   // 23 stem
        let gr[10] = 8;   // 24 base flare
        let gr[11] = 10;  // 25 base
        let gr[12] = 10;  // 26 base
        let gr[13] = 8;   // 27 taper
        let gr[14] = 8;   // 28
        let gr[15] = 6;   // 29
        let gr[16] = 6;   // 30
        let gr[17] = 4;   // 31 end

        let i = 0;
        while (i < 18) {
            let y = yTop + 14 + i;
            // Only draw if within screen bounds
            if ((y > (-1)) & (y < 256)) {
                let half = gr[i] / 2;
                let x0 = cx - half;
                let x1 = cx + half - 1;
                do Screen.drawRectangle(x0, y, x1, y);
            }
            let i = i + 1;
        }

        do w.dispose(); do gl.dispose(); do gc.dispose(); do gr.dispose();
        return;
    }
}
