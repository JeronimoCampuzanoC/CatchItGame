class Main {
    function void main() {
        
        // Objetos de sprites
        var HeartSprite heartSprite;
        var SpadeSprite spadeSprite;
        var DiamondSprite diamondSprite;
        var ClubSprite clubSprite;
        var Points pointsObject;
        var Dropper dropperObject;

        // Variables pa ver lo del teclado
        var int key, lastKey;

        // Variables para lo de la ventana de oportunidad pa apretar la tecla
        // (DBD Reference oyeah)
        var int speed, maxY, targetY, window, dy;
        var bool gameRunning;

        // Los valores iniciales para cuando empezamos a correr el programa
        let speed   = 2;
        let maxY    = 256 - 32;
        let targetY = 200;
        let window  = 8;
        let lastKey = 0;
        let gameRunning = true;

        // Instantiate sprites and points
        let heartSprite = HeartSprite.new(1);
        
        let spadeSprite = SpadeSprite.new(2);
        let diamondSprite = DiamondSprite.new(3);
        let clubSprite = ClubSprite.new(4);
        let pointsObject = Points.new();

        let dropperObject = Dropper.new();

        do Screen.clearScreen();

        while (gameRunning = true) {

            //Check Dropper
            
            if(dropperObject.getAndIncrement() = 1){
                do heartSprite.setActive(true);
                do heartSprite.setY(0);
            }

            if(dropperObject.getValue() = 2){
                do spadeSprite.setActive(true);
                do spadeSprite.setY(0);
            }

            if(dropperObject.getValue() = 3){
                do diamondSprite.setActive(true);
                do diamondSprite.setY(0);
            }

            if(dropperObject.getValue() = 4){
                do clubSprite.setActive(true);
                do clubSprite.setY(0);
            }

            // Check Keyboard

            let key = Keyboard.keyPressed();

            // Checkea lo de la tecla, y si la coge frena el programa
            if (key = 130) {
                if (~(lastKey = 130)) {
                    let dy = heartSprite.getDistanceFrom(targetY);
                    if (dy < (window + 1)) {
                        if (heartSprite.isActive()) {
                            do heartSprite.eraseCurrent();
                            do heartSprite.setActive(false);
                            do pointsObject.addPoint();
                        }
                    }
                }
            }

            if (key = 131) {
                if (~(lastKey = 131)) {
                    let dy = spadeSprite.getDistanceFrom(targetY);
                    if (dy < (window + 1)) {
                        if (spadeSprite.isActive()) {
                            do spadeSprite.eraseCurrent();
                            do spadeSprite.setActive(false);
                            do pointsObject.addPoint();
                        }
                    }
                }
            }

            if (key = 132) {
                if (~(lastKey = 132)) {
                    let dy = clubSprite.getDistanceFrom(targetY);
                    if (dy < (window + 1)) {
                        if (clubSprite.isActive()) {
                            do clubSprite.eraseCurrent();
                            do clubSprite.setActive(false);
                            do pointsObject.addPoint();
                        }
                    }
                }
            }

            if (key = 133) {
                if (~(lastKey = 133)) {
                    let dy = diamondSprite.getDistanceFrom(targetY);
                    if (dy < (window + 1)) {
                        if (diamondSprite.isActive()) {
                            do diamondSprite.eraseCurrent();
                            do diamondSprite.setActive(false);
                            do pointsObject.addPoint();
                        }
                    }
                }
            }

            //Down sprites

            // Borrado en la posicion anterior
            if (heartSprite.isActive()) {
                do heartSprite.erase();
            }
            if (spadeSprite.isActive()) {
                do spadeSprite.erase();
            }
            if (diamondSprite.isActive()) {
                do diamondSprite.erase();
            }
            if (clubSprite.isActive()) {
                do clubSprite.erase();
            }

            // Creado en la posicion nueva
            do Screen.setColor(true);
            do ScreenInitial.divideIntoFourColumns();
            if (heartSprite.isActive()) {
                do heartSprite.draw();
            }
            if (spadeSprite.isActive()) {
                do spadeSprite.draw();
            }
            if (diamondSprite.isActive()) {
                do diamondSprite.draw();
            }
            if (clubSprite.isActive()) {
                do clubSprite.draw();
            }

            // Actualiza valores
            do heartSprite.updatePosition(speed);
            do spadeSprite.updatePosition(speed);
            do diamondSprite.updatePosition(speed);
            do clubSprite.updatePosition(speed);
            
            let lastKey = key;
            do Sys.wait(16);


        }

        // Cleanup
        do heartSprite.dispose();
        do spadeSprite.dispose();
        do diamondSprite.dispose();
        do clubSprite.dispose();

        return;
    }
}
