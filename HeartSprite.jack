// HeartSprite.jack
// Draws a 32x32-ish heart silhouette at the top of a given column (1..4).
// Uses Screen.drawRectangle with horizontal spans (no bit ops).

class HeartSprite {
    field int y, prevY, column;
    field bool active;

    constructor HeartSprite new(int col) {
        let column = col;
        let y = 0;
        let prevY = -1;
        let active = true;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method int getY() {
        return y;
    }

    method void setY(int newY) {
        let y = newY;
        return;
    }

    method void updatePosition(int speed) {
        let prevY = y;
        let y = y + speed;
        return;
    }

    method void draw() {
        do Screen.setColor(true);
        do HeartSprite.drawAtColumnTopWithOffset(column, y);
        return;
    }

    method void erase() {
        if (prevY > (-1)) {
            do Screen.setColor(false);
            do HeartSprite.drawAtColumnTopWithOffset(column, prevY);
        }
        return;
    }

    method void eraseCurrent() {
        do Screen.setColor(false);
        do HeartSprite.drawAtColumnTopWithOffset(column, y);
        return;
    }

    method bool isActive() {
        return active;
    }

    method void setActive(bool val) {
        let active = val;
        return;
    }

    method int getDistanceFrom(int targetY) {
        var int dy;
        let dy = y - targetY;
        if (dy < 0) {
            let dy = 0 - dy;
        }
        return dy;
    }

    // Convenience: draw at top of a column, yOffset lets you lower it a little.
    function void drawAtColumnTop(int column) {
        do HeartSprite.drawAtColumnTopWithOffset(column, 0);
        return;
    }

    function void drawAtColumnTopWithOffset(int column, int yOffset) {
        var int colWidth, cx;
        let colWidth = 512 / 4;                             // 128 px per column
        let cx = (column - 1) * colWidth + (colWidth / 2);  // centers: 64,192,320,448
        do HeartSprite.drawHeart32At(cx, yOffset);
        return;
    }

    // Internal: draw a 32x32 heart centered at (cx, yTop).
    function void drawHeart32At(int cx, int yTop) {
        var Array s, g, w;          // top lobes widths, gaps; lower single-span widths
        var int i, j, y, half, x0, x1, halfGap, left0, left1, right0, right1;

        // ---- Top lobes (rows 0..3): two separated spans per row ----
        let s = Array.new(4);  // per-row lobe span width
        let g = Array.new(4);  // per-row center gap
        let s[0] = 6;  let g[0] = 10;
        let s[1] = 8;  let g[1] = 8;
        let s[2] = 10; let g[2] = 6;
        let s[3] = 12; let g[3] = 4;

        let i = 0;
        while (i < 4) {
            let y = yTop + i;
            // Only draw if within screen bounds
            if ((y > (-1)) & (y < 256)) {
                let halfGap = g[i] / 2;                 // keep gaps even numbers
                // Left lobe span
                let left0 = cx - halfGap - s[i];
                let left1 = left0 + s[i] - 1;
                // Right lobe span
                let right0 = cx + halfGap;
                let right1 = right0 + s[i] - 1;

                do Screen.drawRectangle(left0,  y, left1,  y);
                do Screen.drawRectangle(right0, y, right1, y);
            }

            let i = i + 1;
        }

        // ---- Body & taper (rows 4..31): single centered span per row ----
        // 28 rows of widths; max ~32, then taper to a point.
        let w = Array.new(28);
        let w[0]  = 22;   let w[1]  = 26;   let w[2]  = 30;   let w[3]  = 32;
        let w[4]  = 32;   let w[5]  = 32;   let w[6]  = 30;   let w[7]  = 28;
        let w[8]  = 26;   let w[9]  = 24;   let w[10] = 22;   let w[11] = 20;
        let w[12] = 18;   let w[13] = 16;   let w[14] = 16;   let w[15] = 14;
        let w[16] = 12;   let w[17] = 10;   let w[18] = 10;   let w[19] = 8;
        let w[20] = 8;    let w[21] = 6;    let w[22] = 6;    let w[23] = 4;
        let w[24] = 4;    let w[25] = 2;    let w[26] = 2;    let w[27] = 2;

        let j = 0;
        while (j < 28) {
            let y = yTop + 4 + j;                   // rows 4..31
            // Only draw if within screen bounds
            if ((y > (-1)) & (y < 256)) {
                let half = w[j] / 2;
                let x0 = cx - half;
                let x1 = cx + half - 1;                 // inclusive end

                do Screen.drawRectangle(x0, y, x1, y);
            }

            let j = j + 1;
        }

        do s.dispose();
        do g.dispose();
        do w.dispose();
        return;
    }
}
